@model List<Student>
@{
    ViewData["Title"] = "Student List";
}

<h2>Student List</h2>

@if (TempData["Success"] != null)
{
    <div class="alert">@TempData["Success"]</div>
}

<p><a class="btn" asp-action="Create">+ Register New Student</a></p>

@if (Model.Count == 0)
{
    <p>No students registered yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Semester</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.Email</td>
                <td>@s.Course</td>
                <td>@s.Semester</td>
                <td><a asp-action="Details" asp-route-id="@s.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
