@model Student
@{
    ViewData["Title"] = "Register Student";
}

<h2 class="page-title">Student Registration</h2>

<form asp-action="Create" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" placeholder="e.g. Rahul Sharma" />
        <span asp-validation-for="Name" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="Email"></label>
        <input asp-for="Email" placeholder="e.g. rahul@example.com" />
        <span asp-validation-for="Email" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="Course"></label>
        <select asp-for="Course" asp-items="(SelectList)ViewBag.Courses">
            <option value="">-- Select Course --</option>
        </select>
        <span asp-validation-for="Course" class="error"></span>
    </div>

    <div class="field">
        <label asp-for="Semester"></label>
        <input asp-for="Semester" type="number" placeholder="1 - 8" />
        <span asp-validation-for="Semester" class="error"></span>
    </div>

    <button type="submit" class="btn">Register</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
