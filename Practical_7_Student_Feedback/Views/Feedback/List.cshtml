@model List<P7_Student_Feedback.Models.Feedback>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Feedback List</title>
</head>
<body>
    <h2>Feedback List</h2>

    <table border="1">
        <thead>
            <tr>
                <th>Enrollment No</th>
                <th>Student Name</th>
                <th>Subject</th>
                <th>Rating</th>
                <th>Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feedback in Model)
            {
                <tr>
                    <td>@feedback.EnrollmentNo</td>
                    <td>@feedback.Name</td>
                    <td>@feedback.Subject</td>
                    <td>@feedback.Rating</td>
                    <td>@feedback.Comments</td>
                </tr>
            }
        </tbody>
    </table>

    <br />

    @Html.ActionLink("Give Another Feedback", "Create", "Feedback")

    <br /> 
    
    @Html.ActionLink("Back to Home", "Index", "Feedback")
</body>
</html>