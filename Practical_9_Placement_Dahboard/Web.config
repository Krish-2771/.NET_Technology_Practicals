<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Change Data Source if your PlacementDB is hosted on another SQL Server instance. -->
    <add name="PlacementDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PlacementDB;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <defaultDocument><files><clear/><add value="Dashboard.aspx"/></files></defaultDocument>
  </system.webServer>
</configuration>
