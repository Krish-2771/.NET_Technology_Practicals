@model Practical_8.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>
    <h2>Add New Product</h2>

    @using (Html.BeginForm("Create", "Product", FormMethod.Post))
    {
        <table border="1">
            <tr>
                <td>Product Name</td>
                <td>@Html.TextBoxFor(m => m.ProductName, new { required = "required" })</td>
            </tr>
            <tr>
                <td>Quantity</td>
                <td>@Html.TextBoxFor(m => m.Quantity, new { type = "number", min = "0", required = "required" })</td>
            </tr>
            <tr>
                <td>Price</td>
                <td>@Html.TextBoxFor(m => m.Price, new { type = "number", step = "0.01", min = "0", required = "required" })</td>
            </tr>
            <tr>
                <td colspan="2">
                    <input type="submit" value="Save" />
                    @Html.ActionLink("Back to List", "Index", "Product")
                </td>
            </tr>
        </table>
    }
</body>
</html>